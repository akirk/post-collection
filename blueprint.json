{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Post Collection",
		"description": "Collect posts from around the web, including their contents and review them in one place.",
		"author": "Alex Kirk",
		"categories": [
			"Apps",
			"Education"
		]
	},
	"landingPage": "/post-collection/",
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/akirk/post-collection",
				"ref": "dist/main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "learn-app"
			}
		}
	]
}
