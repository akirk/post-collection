{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Post Collection",
		"description": "Save articles from around the web, extract readable content, organize them into collections, and review them with notes in WordPress.",
		"author": "Alex Kirk",
		"categories": [
			"Apps",
			"Education"
		]
	},
	"landingPage": "/wp-admin/index.php?desktop_mode_portal=1",
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/openstation/releases/latest/download/openstation.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/akirk/post-collection",
				"ref": "dist/main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "post-collection"
			}
		}
	]
}
